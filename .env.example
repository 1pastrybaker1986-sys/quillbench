# Quillbench Stripe / billing env (placeholders only — no real secrets).
# Leave VITE_BILLING_MODE unset or stub for local unlock (default).
# Set stripe only after a Checkout Session serverless function exists.
VITE_BILLING_MODE=stub

# Publishable key only (pk_test_… / pk_live_…). Never put sk_… in VITE_*.
VITE_STRIPE_PUBLISHABLE_KEY=

# Price ids from Stripe Dashboard Products (price_…)
VITE_STRIPE_PRICE_FULL_EDIT=
VITE_STRIPE_PRICE_COVER_DESIGN=
VITE_STRIPE_PRICE_MARKETING=
VITE_STRIPE_PRICE_STUDIO_BUNDLE=

# Optional session-create URL override (default Netlify function path).
# VITE_STRIPE_CHECKOUT_SESSION_URL=/.netlify/functions/create-checkout-session
