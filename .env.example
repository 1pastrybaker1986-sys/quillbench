# Quillbench Stripe / billing env (placeholders only — no real secrets).
# Leave VITE_BILLING_MODE unset or stub for local unlock (default).
# Set stripe after Netlify create-checkout-session + Stripe Dashboard prices exist.
VITE_BILLING_MODE=stub

# --- Client build (Vite / Netlify build env) ---
# Publishable key only (pk_test_… / pk_live_…). Never put sk_… in VITE_*.
VITE_STRIPE_PUBLISHABLE_KEY=

# Price ids from Stripe Dashboard Products (price_…) — optional on client;
# Netlify function prefers STRIPE_PRICE_* server env over these.
VITE_STRIPE_PRICE_FULL_EDIT=
VITE_STRIPE_PRICE_COVER_DESIGN=
VITE_STRIPE_PRICE_MARKETING=
VITE_STRIPE_PRICE_STUDIO_BUNDLE=

# Optional session-create URL override (default Netlify function path).
# VITE_STRIPE_CHECKOUT_SESSION_URL=/.netlify/functions/create-checkout-session

# --- Netlify Functions env (Site settings → Environment variables) ---
# Functions only — never expose these as VITE_* client vars.
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_PRICE_FULL_EDIT=price_…
# STRIPE_PRICE_COVER_DESIGN=price_…
# STRIPE_PRICE_MARKETING=price_…
# STRIPE_PRICE_STUDIO_BUNDLE=price_…
